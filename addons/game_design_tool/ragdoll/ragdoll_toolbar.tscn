[gd_scene format=3]

[ext_resource type="Script" path="res://addons/game_design_tool/ragdoll/ragdoll_toolbar.gd" id="1_toolbar"]

[node name="RagdollToolbar" type="HBoxContainer"]
script = ExtResource("1_toolbar")

[node name="Separator" type="VSeparator" parent="."]
layout_mode = 2

[node name="Simulate" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Симуляция рэгдолла: тела падают из своей позы. Отжать — поза запишется в сцену (Ctrl+Z вернёт)."
toggle_mode = true
text = "Рэгдолл"
flat = true

[node name="Scope" type="OptionButton" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Какие рэгдоллы падают: тела, внутри которых выделен узел, или все в сцене."
flat = true
selected = 0
item_count = 2
popup/item_0/text = "Выбранные"
popup/item_0/id = 0
popup/item_1/text = "Все в сцене"
popup/item_1/id = 1

[node name="Status" type="Label" parent="."]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.7)
layout_mode = 2
