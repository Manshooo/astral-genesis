[gd_resource type="Resource" script_class="RS_RoomTagCatalog" format=3 uid="uid://cvurmu7r4liha"]

[ext_resource type="Script" uid="uid://f1yibb7rrgrr" path="res://src/resources/world_generator/rs_room_tag.gd" id="1_tag"]
[ext_resource type="Script" uid="uid://dh23vjexwhfd7" path="res://src/resources/world_generator/rs_room_tag_catalog.gd" id="2_catalog"]

[sub_resource type="Resource" id="Resource_floor_hub"]
script = ExtResource("1_tag")
id = &"floor_hub"
display_name = "Хаб этажа"
description = "Узел-коннектор между этажами ОДНОГО слоя комплекса: подъём внутри уже загруженной области, без замка. Генератор вешает тег сам, поэтому пресет без floor_hub в такой узел не попадёт — отсюда он почти у всех обычных комнат."
set_by_generator = true

[sub_resource type="Resource" id="Resource_vertical_hub"]
script = ExtResource("1_tag")
id = &"vertical_hub"
display_name = "Вертикальный хаб"
description = "Узел-коннектор между СЛОЯМИ: лифт или лестничный колодец с переходом на глубину ±1, может быть заперт ключом доступа. Сцене нужна вертикальная связь, поэтому обычные комнаты тег не носят — а по специфичности он же уводит такой узел от рядовых пресетов."
set_by_generator = true

[sub_resource type="Resource" id="Resource_level_exit"]
script = ExtResource("1_tag")
id = &"level_exit"
display_name = "Выход со слоя"
description = "Узел, выбранный точкой выхода на следующий слой. В сцене обязана быть дверь с действием A_FinishRun — без неё забег в этой комнате нечем закончить."
set_by_generator = true

[resource]
script = ExtResource("2_catalog")
tags = Array[ExtResource("1_tag")]([SubResource("Resource_floor_hub"), SubResource("Resource_vertical_hub"), SubResource("Resource_level_exit")])
