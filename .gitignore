# Godot 4+ specific ignores
.godot/
/android/

.obsidian/
builds/

# Локальная сборка релиза (dev/release.ps1) — то же, что CI кладёт на раннере.
# Только в корне: без ведущего слеша правило съедало бы и build/ проекта byProd
# (assets/sound/*/build/), а это собранный звук, который игре нужен в git.
/build/
/dist/

*.tscn[0-9]*.tmp
*.tscn.tmp

# На Windows нет устройства /dev/null: перенаправление в него из скриптов
# (напр. `git lfs install`) создаёт настоящий каталог dev/null с копиями хуков.
/dev/null/

# Рантайм byProd (Madrigal Ltd.). Его лицензия разрешает распространять библиотеку
# только встроенной в приложение — в публичном репозитории она лежала бы «сама по
# себе», что пункт 2 лицензии запрещает. Поэтому файл кладётся локально из SDK и
# попадает только в экспортированную сборку. Само расширение (MIT) — в git.
/addons/byprod/bin/byProd.dll
/addons/byprod/bin/libbyProd.so

# Побочный файл сборки byProd: список исходных волн АБСОЛЮТНЫМИ путями той
# машины, на которой собирали. Игре он не нужен (рантайм читает .byprod и
# .bybank), а в git конфликтовал бы между машинами на каждой пересборке.
*_wave_assets.txt

# Временный файл линковщика при локальной сборке godot-byprod на Windows
# (атомарная запись поверх .dll) — остаётся, если сборка прервалась.
/addons/byprod/bin/~*.dll
