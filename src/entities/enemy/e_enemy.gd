# res://src/entities/enemy/e_enemy.gd
## Живая версия тела — бежит на воплощённого БФЖ и бьёт в упор (S_EnemyAI). Не
## тело: захватить его нельзя (нет C_BodySnatchable), и с трупами-целями захвата
## (E_Body) не путать — это разные сущности с разными задачами. Но у каждого
## врага есть труп — сцена [member corpse_scene], экземпляр E_Body, на месте
## которого враг оказывается после смерти (O_EnemyDeath); вот в труп и
## вселяются. Облик врага — тот же меш, что у его тела: живой и мёртвый
## выглядят как один и тот же человек.
##
## Корень — CharacterBody3D, а не StaticBody3D, как у E_Body: враг ходит, и
## только CharacterBody3D слушает C_Velocity через move_and_slide()
## (S_Movement). Слой коллизии — enemies, как у тел. Луч захвата
## (S_SnatchTargetDetector) проходит врага насквозь, поэтому тот не заслоняет
## настоящие цели у себя за спиной, а луч удара (S_Attack) его, наоборот, ловит:
## он живой, у него есть C_Health. Маска и почему враг упирается в игрока, а
## игрок во врага нет — docs «Конвенции проекта», §2.
##
## Рэгдолла у живого врага нет: он ходит жёстким мешем в bind-позе, как риг
## игрока в чужом теле. Рэгдолл включается уже у трупа — его _ready.
@tool
class_name E_Enemy
extends Entity

## Тело, которое остаётся на месте врага после смерти. Сцена, а не готовый узел:
## труп обязан быть настоящим экземпляром сцены E_Body — сейв восстанавливает
## вселённое тело по её пути (E_Body.*_of_scene), а свежее здоровье он берёт из
## её же component_resources, поэтому «полное HP у трупа» не требует ни строки
## кода. Пусто — враг умирает, ничего не оставив.
@export var corpse_scene: PackedScene


## Класс угрозы врага по шкале L0..L5 — класс его трупа. Отдельного поля у врага
## нет намеренно: «кто это» один раз записано в сцене трупа (E_Body.body_class),
## и второе число рядом разошлось бы с первым при первой же правке баланса.
## 0, если трупа нет: безымянный враг не получает ни сопротивления, ни награды.
func threat_class() -> int:
	if corpse_scene == null:
		return 0
	return E_Body.class_of_scene(corpse_scene.resource_path)
