## Свет одного слоя комплекса: чем глубже, тем темнее — и темнеет мир, а не
## глаз. Поэтому здесь фоновый свет, лампы и туман, но нет экспозиции: она одна
## на всю игру (камера мира плюс яркость игрока), и подстрой её под слой —
## разница между поверхностью и дном исчезла бы, как от автоэкспозиции.
##
## Фоновый свет — нижняя граница видимости: без него всё, куда не достаёт лампа,
## было ровно чёрным (окружение мира держало его выключенным). Тени от него нет,
## объём в углах возвращает SSAO, который гасит именно фоновый свет.
class_name RS_DepthLight
extends Resource

@export_group("Фоновый свет")
@export var ambient_color: Color = Color(0.5, 0.55, 0.65)
@export_range(0.0, 2.0, 0.01) var ambient_energy: float = 0.1

@export_group("Лампы")
## Множитель авторской энергии каждой лампы уровня (LevelLight) — комнат и
## тайлов коридора. Множитель, а не энергия: у ламп комнат свои числа.
@export_range(0.0, 3.0, 0.01) var lamp_energy_scale: float = 1.0
## Доля погасших ламп коридора. Только коридоров: комната — авторская сцена со
## своим светом, обычно с одной лампой, и погасшая лампа там — тёмная комната,
## а пропуск в цепочке коридорных ламп читается как участок без света.
@export_range(0.0, 1.0, 0.01) var dead_lamp_chance: float = 0.0

@export_group("Туман")
## Цвет тумана по глубине: у поверхности — серая дымка, в глубине — почти
## чёрный. Дальность тумана не здесь: он густеет туда, где гаснут лампы
## (LevelEnvironment).
@export var fog_color: Color = Color(0.02, 0.02, 0.025)
