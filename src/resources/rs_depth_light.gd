## Свет одного слоя комплекса: чем глубже, тем темнее мир (не глаз): фоновый свет, лампы, туман, но не экспозиция — она одна на игру.
## Фоновый свет — нижняя граница видимости (без него вне ламп чёрное); теней от него нет, объём в углах даёт SSAO.
## Вики: [[Визуальный стиль и текстуры]] (Свет по глубине).
class_name RS_DepthLight
extends Resource

@export_group("Фоновый свет")
@export var ambient_color: Color = Color(0.5, 0.55, 0.65)
@export_range(0.0, 2.0, 0.01) var ambient_energy: float = 0.1

@export_group("Лампы")
## Множитель авторской энергии каждой лампы уровня (у ламп комнат свои числа).
@export_range(0.0, 3.0, 0.01) var lamp_energy_scale: float = 1.0
## Доля погасших ламп коридора (только коридоров: в комнате погасшая лампа — тёмная комната).
@export_range(0.0, 1.0, 0.01) var dead_lamp_chance: float = 0.0

@export_group("Туман")
## Цвет тумана: у поверхности серая дымка, в глубине почти чёрный. Дальность — LevelEnvironment.
@export var fog_color: Color = Color(0.02, 0.02, 0.025)
## Плотность тумана: 0 — нет, 1 — к концу скрывает всё; у поверхности дымки быть не должно (читалась мутью).
@export_range(0.0, 1.0, 0.01) var fog_density: float = 1.0
