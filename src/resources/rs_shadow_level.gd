# res://src/resources/rs_shadow_level.gd
## Одна ступень качества теней в настройке «Тени»: разрешение атласа, мягкость
## краёв и дальность, до которой лампы отбрасывают тень, — одним пунктом, а не
## тремя ручками. По отдельности игрок не знал бы, что крутить: «разрешение»
## без дальности не снимает цену кадра, а дальность без разрешения не прибавляет
## чёткости. Ступени лежат в каталоге пресетов (RS_GraphicsPresetLibrary), и
## новая ступень — строка данных, а не правка меню.
##
## «Выкл» здесь ступенью не описан: это не уровень качества, а его отсутствие
## (RS_GraphicsPreset.SHADOWS_OFF).
class_name RS_ShadowLevel
extends Resource

## Ключ ступени — то, что хранится в RS_Settings.shadow_quality и в пресетах.
@export var id: StringName = &""
## Ключ перевода пункта списка.
@export var display_name: String = ""
## Атлас позиционных теней (и направленных — у игры он один на оба). Степень
## двойки: промежуточное значение движок всё равно округлит вверх, и
## «1536» в меню был бы тем же 2048 под другим именем.
@export var atlas_size: int = 2048
## Фильтр мягких теней. Дёшево на «жёстких» и дорого на «ультра»: число выборок
## на пиксель растёт со ступенью.
@export var soft_filter: RenderingServer.ShadowQuality = RenderingServer.SHADOW_QUALITY_SOFT_LOW
## Дальше скольких метров от камеры лампа тени не отбрасывает
## (Light3D.distance_fade_shadow, ставит LevelLight). Главная ручка цены: на слое
## ~170 ламп, и тень — это отдельная карта на каждую видимую.
@export var shadow_distance: float = 40.0
## На сколько ячеек режется каждая из четырёх четвертей атласа — ОДИНАКОВО для
## всех четвертей. Godot выдаёт лампе ячейку по тому, насколько велика лампа на
## экране, и у лампы вне кадра этот размер выходит почти нулевым: при разных
## четвертях она получала самую мелкую ячейку, и тени от неё на видимых стенах
## рассыпались в квадраты. Ячейки одного размера не оставляют движку выбора —
## каждая лампа получает одно и то же разрешение (atlas_size / 2 / √ячеек). Цена —
## число ламп с тенью ограничено, его держит ShadowBudget.
##
## Не меньше 16 ячеек в четверти: омни-лампа занимает ПАРУ соседних ячеек, и при
## четырёх пара рвётся — лампа, заняв ячейки 1–2, оставляет 0 и 3 одиночками, и
## следующая остаётся без тени при формально свободном месте. Так и было на
## пробе 2048 × 4: шесть ламп на бюджет восемь, а потолок всё равно засвечивало.
@export var cells_per_quadrant: Viewport.PositionalShadowAtlasQuadrantSubdiv = Viewport.SHADOW_ATLAS_QUADRANT_SUBDIV_16

## Ячеек в четверти по значению Viewport.PositionalShadowAtlasQuadrantSubdiv.
const _CELLS := [0, 1, 4, 16, 64, 256, 1024]


## Сколько ламп одновременно в кадре может отбрасывать тень: четвертей четыре,
## а омни-лампа занимает две ячейки (атлас держит её двумя полусферами).
func lamp_budget() -> int:
	return _CELLS[cells_per_quadrant] * 2
