class_name RS_SkillBranch
extends Resource
## Ветка дерева навыков: подпись и цвет дорожки в graph-UI.
##
## Заведена ресурсом, а не словарём в коде UI, по той же причине, по которой
## данными объявляются сами навыки: русское название ветки и её цвет правятся
## там же, где и навыки, — в data/skill_tree.tres. До неё UI писал
## str(branch).capitalize() и показывал игроку «Possession».
##
## Ветка НЕ обязательна: навык с неизвестным branch всё равно попадёт в граф,
## получив дорожку с подписью из своего id. Иначе опечатка в имени ветки прятала
## бы навык от игрока насовсем — а это самая дорогая из возможных ошибок данных.

## Цвет ветки, которую не описали. Константой, а не литералом в двух местах:
## RS_SkillTree.branch_color возвращает его же, и разъехаться они не должны.
const DEFAULT_COLOR := Color(0.62, 0.72, 0.85)

@export var id: StringName = &""
@export var display_name: String = ""
## Акцент дорожки: подложка ветки, полоска на карточке навыка, связи в неё.
@export var color: Color = DEFAULT_COLOR
