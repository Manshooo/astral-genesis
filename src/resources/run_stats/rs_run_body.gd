## res://src/resources/run_stats/rs_run_body.gd
## Одно тело, занятое за забег, — запись в [RS_RunStats.bodies].
##
## У записи свой словарь счётчиков по той же причине, по какой он есть у забега
## целиком: показатели «в каком теле сколько раз нажата способность» и «какие
## артефакты на него влияли» уже заявлены, но ещё не существуют. Когда они
## появятся, им нужен будет карман ПО ТЕЛУ, а не общий на забег, — вот он.
class_name RS_RunBody
extends Resource

## Путь сцены тела — тот же «id пресета», которым воплощение живёт в сейве
## (`RS_WorldSave.body_scene_path`).
@export var scene_path: String = ""

## Ключ перевода имени тела, прочитанный из сцены (`E_Body.display_name_key`).
## Храним ключ, а не готовую строку: сводку могут показать на другом языке, чем
## тот, на котором шёл забег (история забегов, v0.7.0).
@export var name_key: StringName = &""

## Секунда забега, на которой тело занято. Пока не показывается — но без неё
## порядок событий в записи не восстановить, а он понадобится хронике забега.
@export var taken_at: float = 0.0

## Показатели, накопленные ИМЕННО в этом теле. Пусто — ничего такого пока не
## считается.
@export var counters: Dictionary[StringName, float] = {}
