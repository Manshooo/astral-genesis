## res://src/resources/run_stats/rs_run_stat_row.gd
## Одна строка сводки забега: какой показатель показать, под какой подписью и
## каким видом.
##
## Строка — ДАННЫЕ, а не узел в сцене экрана: набор показателей открыт, и
## добавление нового обязано стоить строки в `data/run_stat_catalog.tres`, а не
## правки вёрстки. Тот же приём, что у навыков (`data/skill_tree.tres`) и типов
## комнат (`data/room_type_catalog.tres`).
@tool
class_name RS_RunStatRow
extends Resource

## Как показать значение. Не «формат числа», а вид показателя: список тел
## значением не является вовсе, но живёт такой же строкой сводки.
enum Format {
	NUMBER,  ## целое: комнаты, тела, урон, очки
	TIME,  ## секунды забега как ММ:СС
	BODY_LIST,  ## перечисление занятых тел по именам
}

## Ключ показателя из [RS_RunStats] (`RS_RunStats.ROOMS` и т.п.). Для BODY_LIST
## не используется — там значение берётся из массива записей.
@export var key: StringName = &""

## Ключ ПЕРЕВОДА подписи, а не сама подпись: всё, что видит игрок, обязано
## переводиться (см. `assets/locale/ui.csv`).
@export var label_key: StringName = &""

@export var format: Format = Format.NUMBER

## Прятать строку, когда показывать нечего (ноль, пустой список). Урон, которого
## не было, — это не «0», это строка, которой в сводке не место; а вот время и
## комнаты честнее показать даже нулями.
@export var hide_when_empty: bool = true
