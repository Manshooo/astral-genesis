## res://src/resources/world_generator/rs_room_type.gd
## Один тип помещения комплекса: арсенал, лаборатория, склад.
##
## Тип отвечает на вопрос «ЧТО это за помещение» и структурных обязательств не
## несёт — арсенал может оказаться и тупиком, и проходной, и вертикальным хабом.
## Этим он отличается от `tags` пресета/узла, которые отвечают на другой вопрос —
## «что комната умеет структурно» (`vertical_hub`, `floor_hub`, `level_exit`) — и
## работают жёстким фильтром вместимости. Смешивать оси нельзя: тег типа стал бы
## требованием, а специфичность поехала бы (см. RS_RoomPresetLibrary).
@tool  # каталог правится и читается из редакторского дока «Генератор»
class_name RS_RoomType
extends Resource

## Ключ типа: `arsenal`, `lab`, `storage`. Он же лежит в
## RS_RoomPreset.room_type и RS_LevelNode.room_type — сравнение идёт по нему,
## а не по display_name.
@export var id: StringName = &""

## Человеческое имя для инструментов и (в будущем) для пометок на карте.
@export var display_name: String = ""

## Чем это помещение отличается от соседних — заметка дизайнера для
## редакторских инструментов, в игру не попадает. Пустое описание не ошибка:
## у типа есть display_name, и «Арсенал» чаще всего объясняет себя сам.
@export_multiline var description: String = ""

## Вес в розыгрыше типа для узла. <= 0 выключает тип, не удаляя его из каталога.
@export var weight: float = 1.0

@export_group("Глубина")

## Границы по номеру слоя: **0 — поверхность, 4 — самый глубокий**
## (RS_LevelGraph.DEPTHS). Тип разыгрывается только на узлах, чья `depth` попала
## в отрезок включительно.
##
## Это и есть «влиять на распределение по глубине» из задачи: казармы и столовые
## живут ближе к поверхности (0–2), содержание существ — глубже (3–4), где по
## лору уже усиленная охрана.
@export var depth_min: int = 0
@export var depth_max: int = 4


## Годится ли тип для узла такой глубины.
func covers_depth(depth: int) -> bool:
	return depth >= depth_min and depth <= depth_max


## Для инструментов и логов: имя, если задано, иначе ключ.
func label() -> String:
	return display_name if display_name != "" else String(id)
