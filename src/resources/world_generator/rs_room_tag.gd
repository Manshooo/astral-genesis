## res://src/resources/world_generator/rs_room_tag.gd
## Описание одного структурного тега комнаты: что он значит и когда его вешать
## на пресет. Данные — `data/room_tag_catalog.tres`, правятся в редакторе.
##
## Ресурс ОПИСАТЕЛЬНЫЙ, а не разрешительный: подбор комнаты по-прежнему сравнивает
## сырые `StringName` (`node.tags ⊆ preset.tags` в RS_RoomPresetLibrary) и в
## каталог не заглядывает вовсе. Тег, которого здесь нет, работает как работал —
## иначе «+ тег» в Room Wizard молча ломал бы генерацию, требуя сперва сходить
## завести описание. Каталог отвечает ровно на один вопрос: что этот тег значит.
@tool  # каталог правится из вкладки «Генератор» — иначе placeholder-инстанс
class_name RS_RoomTag
extends Resource

## Ключ тега: `floor_hub`, `vertical_hub`, `level_exit`. Он же лежит в
## RS_RoomPreset.tags и RS_LevelNode.tags — сравнение идёт по нему.
@export var id: StringName = &""

## Человеческое имя для инструментов. Пустое — показывается ключ.
@export var display_name: String = ""

## Зачем тег нужен и когда его вешать. Текст для дизайнера в редакторских
## инструментах, в игру не попадает.
@export_multiline var description: String = ""

## Тег, который генератор ставит узлам САМ (RS_LevelGraph): ключ захардкожен в
## коде графа, поэтому переименовать его только в пресетах недостаточно — подбор
## сломается молча, узлы с этим тегом просто перестанут находить комнату.
## Инструменты по этому флагу запрещают переименование.
@export var set_by_generator: bool = false


## Для инструментов и логов: имя, если задано, иначе ключ.
func label() -> String:
	return display_name if display_name != "" else String(id)
