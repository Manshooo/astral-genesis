## res://src/resources/world_generator/rs_unique_room.gd
## Комната, которую генератор не подбирает, а РАЗМЕЩАЕТ: хаб, выход, комната
## Архитектора. Узел резервируется под заранее известную сцену, и рёбер ему
## достаётся ровно столько, сколько в этой сцене дверей.
##
## Заменяет собой гарантированные тупики дома и поверхности: раньше их держали
## якорные константы (HOME_DEPTH, SURFACE_DEPTH) и особый порядок постройки
## остовного дерева, чтобы узлу досталась степень 1 и однодверная сцена влезла.
## Когда степень выводится из сцены, «тупик» получается сам — у хаба одна дверь,
## — а новая уникальная комната становится строкой данных, а не третьим якорем в
## коде (этап 5 карточки «Рефакторинг генератора мира»).
@tool  # читается генератором и в редакторской вкладке «Генератор мира»
class_name RS_UniqueRoom
extends Resource

## Что ставится. Сцена, тип помещения и число дверей — отсюда же.
@export var preset: RS_RoomPreset

@export_group("Где")
## Диапазон глубин, из которого разыгрывается слой (включительно). Для хаба и
## выхода — одна глубина; шире — для комнат вроде Архитектора, чьё место в
## комплексе не закреплено.
@export var depth_min: int = 0
@export var depth_max: int = 0
## Глубины внутри отрезка, на которые комната не встаёт. Архитектор ищется на
## любом слое, кроме слоя хаба: найденный в двух шагах от старта, он перестал бы
## быть находкой. Список, а не второй отрезок: дырка бывает посередине.
@export var excluded_depths: Array[int] = []
## Сколько таких комнат в забеге (выходов, например, два).
@export_range(1, 8) var count: int = 1
## Шанс, что комната вообще окажется в забеге. Бросок тратит rng ВСЕГДА, при
## любом исходе, — иначе уникальная комната, не выпавшая в этот раз, сдвигала
## бы всё, что разыгрывается после неё (урок из «Типов комнат»).
@export_range(0.0, 1.0) var chance: float = 1.0

@export_group("Роль в забеге")
## Отсюда игрок начинает забег (entry_node_id). Ровно одна такая запись.
@export var entry: bool = false
## Отсюда игрок сбегает (exit_node_ids, тег level_exit).
@export var exit: bool = false
## Двери комнаты не открываются, а ПЕРЕСТАВЛЯЮТ игрока в коридор перед ними —
## когда за дверью в арте нет проёма и открывать нечего. Временный флаг хаба:
## проём в hub.glb будет переделан (решено 22.09), после этого флаг снимается
## строкой данных, код не трогается.
@export var door_teleports: bool = false


func covers_depth(depth: int) -> bool:
	return depth >= depth_min and depth <= depth_max and not excluded_depths.has(depth)


## Глубины, из которых разыгрывается слой, по возрастанию. Пусто — отрезок
## целиком вычеркнут (это ловит RS_WorldGenConfig.validate).
func allowed_depths() -> Array[int]:
	var result: Array[int] = []
	for depth in range(depth_min, depth_max + 1):
		if not excluded_depths.has(depth):
			result.append(depth)
	return result
