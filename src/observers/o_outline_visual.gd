## Наблюдатель: переводит меши выделенной сущности на слой обводки и снимает их
## оттуда, когда выделение снялось. Сам контур рисует S_OutlineMask — постэффектом
## по маске этого слоя.
##
## Раньше наблюдатель вешал material_overlay на каждый меш, и три свойства того
## подхода не лечились изнутри него: толщина зависела от геометрии (overlay
## выдавливает меш, поэтому у мелких деталей контур тоньше, а на плоскости
## исчезает вовсе), составной объект обводился по частям с видимыми внутренними
## рёбрами, и меш без material_override мерцал. Слой видимости ничего этого не
## знает: маска не различает, из скольких мешей собран объект, а толщина считается
## в пикселях экрана.
##
## Красим ВСЕ меши сущности, а не один: составной объект (рама + полотно + ручка)
## должен подсвечиваться целиком. Где их искать — знает RS_EntityVisuals, там же
## объяснение, почему правило не завязано на имя узла.
class_name O_OutlineVisual
extends Observer

## Слой видимости, зарезервированный под маску обводки
## (project.godot → layer_names/3d_render/layer_20).
##
## Посторонних мешей на нём быть не должно: камера маски снимает ТОЛЬКО этот
## слой, и любой чужой меш стал бы вторым силуэтом на весь экран. Число одно на
## двоих — S_OutlineMask берёт его отсюда же для cull_mask.
const OUTLINE_LAYER := 1 << 19


func query() -> QueryBuilder:
	return q.with_all([C_Highlighted]).on_added().on_removed()


func each(event: Variant, entity: Entity, _payload: Variant = null) -> void:
	var geometries := RS_EntityVisuals.geometries(entity)
	if geometries.is_empty():
		# Раньше промах был МОЛЧАЛИВЫМ: наблюдатель просто выходил, и отладка
		# «почему не подсвечивается» начиналась с нуля. Объект интерактивный, но
		# рисовать нечего — это ошибка сцены, о ней надо знать.
		if event == Observer.Event.ADDED:
			push_warning(
				"O_OutlineVisual: у «%s» нет ни одного GeometryInstance3D — обводить нечего"
				% entity.name
			)
		return

	# Бит выставляем и снимаем, а не запоминаем прежнюю маску слоёв: слой
	# зарезервирован за обводкой целиком, поэтому «снять» — это всегда «убрать
	# именно этот бит», и восстанавливать нечего. Остальные слои меша не трогаем.
	var lit: bool = event == Observer.Event.ADDED
	for geometry in geometries:
		if lit:
			geometry.layers |= OUTLINE_LAYER
		else:
			geometry.layers = geometry.layers & ~OUTLINE_LAYER
