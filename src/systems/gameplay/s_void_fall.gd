# res://src/systems/gameplay/s_void_fall.gd
# Группа: "gameplay". Дно мира: всё, что провалилось ниже
# GameConfig.void_fall_depth, оттуда уже не вернётся — значит, из мира его надо
# убрать, а не ронять бесконечно.
#
# Существует ради ДЫРОК В ГЕОМЕТРИИ, а не ради честного падения: комнаты
# генерируются, стыкуются дверями и порталами, и щель между кусками — вопрос
# времени, а не «если». Провалившийся игрок без этой системы падает вечно:
# распад тикает, HUD жив, экрана смерти нет — забег превращается в зависание,
# из которого выходят только Alt+F4. Живой прогон уже приносил такое (карточка
# про провал ползуна в портале), и починка КОНКРЕТНОЙ комнаты этого не решает:
# дно нужно всему миру.
#
# ПОРОГ — КООРДИНАТА, А НЕ DEATH BOX. Area3D пришлось бы растягивать под слой,
# двигать за стримингом слоёв и держать на правильном слое коллизий, а ловила
# бы она только тех, у кого есть коллайдер нужной маски. Сравнение одного числа
# не зависит ни от того, ни от другого, и работает в headless без физики вовсе.
#
# ДВА ИСХОДА, и они РАЗНЫЕ:
#   - у сущности есть C_Lifespan (это душа, то есть игрок) — это СМЕРТЬ, а не
#     развоплощение: событие "run_ended" тем же путём, что у догоревшего запаса
#     (S_Lifespan), и дальше O_RunEnded → RunManager.die() → экран смерти.
#     Выбрасывать душу из тела здесь было бы неверно вдвойне: призрак остался бы
#     в той же дыре и продолжил падать, а самой механике «вышел из тела» нужен
#     мир вокруг, которого под миром нет;
#   - всё остальное (враги) — просто убрать из мира. Убийство через C_Health
#     объявило бы смерть с лутом и наблюдателями, хотя случившееся к бою
#     отношения не имеет: их не убили, они выпали из мира.
class_name S_VoidFall
extends System


## Только то, что физически может ПАДАТЬ: без C_Velocity сущность стоит там, где
## её поставил генератор, и провалиться не может (тела в комнатах — StaticBody3D,
## им дно ни к чему). C_Dead исключает уже объявленных мёртвыми, чтобы душа не
## получила "run_ended" второй раз, пока сцена смерти ещё не поднялась.
func query() -> QueryBuilder:
	return q.with_all([C_Velocity]).with_none([C_Dead])


func process(entities: Array[Entity], _components: Array, _delta: float) -> void:
	var floor_y := GameConfig.config.void_fall_depth
	for entity in entities:
		# Entity наследует Node, поэтому до Node3D — через двойной каст.
		# is_inside_tree — не перестраховка: global_position у Node3D вне дерева
		# ругается в консоль, а сущность бывает вне его ровно один кадр после
		# add_entity в том же кадре, что и наш проход.
		var node := entity as Node as Node3D
		if node == null or not node.is_inside_tree():
			continue
		if node.global_position.y > floor_y:
			continue

		var life := entity.get_component(C_Lifespan) as C_Lifespan
		if life:
			_end_run(entity, life)
		else:
			cmd.remove_entity(entity)


## Смерть игрока тем же путём, что и догоревший запас души: обнулить остаток,
## пометить мёртвым и объявить конец забега. Порядок и состав повторяют
## S_Lifespan._tick_soul намеренно — «умер» обязано означать одно и то же, из
## какой бы причины оно ни следовало, иначе HUD и сейв разойдутся по одному из
## двух путей.
##
## C_Dead — через буфер (правило v9: структурные изменения не внутри process),
## событие — синхронно: так же устроен S_Health, и наблюдатели рассчитывают
## именно на этот порядок.
func _end_run(entity: Entity, life: C_Lifespan) -> void:
	life.current = 0.0
	cmd.add_component(entity, C_Dead.new())
	ECS.world.emit_event(&"run_ended", entity)
