# res://src/components/rendering/c_soul_glow.gd
# Свечение души: слабая лампа у глаз игрока, своя у души, а не у слоя. Свет по
# глубине (RS_DepthLight) гасит мир, и на дне без лампы рядом видно мало — душа
# светит сама и тем тусклее, чем ближе распад. Так темнота дна читается ценой
# запаса, а не произволом.
#
# Числа — данные сцены игрока, как и сама лампа (её дальность, затухание): их
# подбирают глазом, а не в коде. Цвет — палитра HUD (UI_HudMood), сиреневый вне
# тела и янтарный во плоти: свечение и дуга распада — одно и то же, сказанное
# дважды, и разойтись в цвете им нельзя.
class_name C_SoulGlow
extends Component

## Лампа свечения относительно сущности игрока. Под камерой: камера садится на
## уровень глаз тела, и свет едет вместе с ней.
@export var light_path: NodePath = ^"Camera3D/SoulGlow"
## Энергия при спокойном запасе.
@export_range(0.0, 4.0, 0.01) var energy_full: float = 0.6
## Энергия на пустом запасе. Не ноль: душа гаснет, но не слепнет — в провале
## погасших ламп иначе не найти выхода.
@export_range(0.0, 4.0, 0.01) var energy_faded: float = 0.12

## Доля янтаря в цвете (0 — душа, 1 — тело). Состояние, а не авторское число:
## перетекает за UI_DecayArc.TINT_SECONDS, в такт дуге.
var body_mix: float = 0.0
