# res://src/components/gameplay/c_player_input.gd
# Намерения игрока за кадр — единственный канал от устройств ввода к механикам.
# Системы движения читают отсюда и не знают ни про клавиши, ни про открытый UI.
#
# ЭТО ЕЩЁ И МАРКЕР ИГРОКА: `query.with_all([C_PlayerInput]).execute_one()` в
# проекте значит «найти игрока». Другой сущности этот компонент не вешать —
# враг ходит своим C_EnemyInput (см. шапку S_Walk про то, что сломалось, когда
# было иначе).
class_name C_PlayerInput
extends Component

# Направление движения от клавиатуры. Заполняет S_PlayerInput.
@export var move_direction := Vector3.ZERO
@export var jump_pressed := false
@export var mouse_delta := Vector2.ZERO

# Удерживается ли сейчас ускорение. НЕПРЕРЫВНОЕ состояние, а не защёлка: бег
# длится, пока клавишу держат, и снять его надо ровно тогда, когда отпустили.
# Заполняет S_PlayerInput — там же, где move_direction, по той же причине
# (опрос удерживаемого ввода живёт в группе "input", а не в каждой системе).
@export var sprint_held := false

# Защёлка НАЖАТИЯ ускорения — нужна не бегу, а отказу в нём. Бег сам обходится
# sprint_held, но сообщить «это тело не умеет бегать» надо один раз на нажатие,
# а не каждый кадр удержания; фронт даёт ровно это. Ставит E_Player._input
# (там же, где jump_pressed), гасит S_Sprint — обе половины защёлки в одном
# файле, см. шапку S_Jump.
@export var sprint_pressed := false


## Отпустить всё УДЕРЖИВАЕМОЕ: направление, бег, накопленный взгляд. Так выглядит
## ввод, пока открыт блокирующий экран (C_UIBlocked), — системы движения при этом
## работают как обычно и просто получают «ничего не нажато». Одно определение на
## двоих: S_PlayerInput держит его каждый кадр блокировки, UIManager — в сам
## момент блокировки, чтобы физкадр до следующего прохода ввода не донёс тело на
## старом направлении. Защёлки (jump_pressed, sprint_pressed) не трогаем: пока
## висит блок, их не взводит E_Player._input, а взведённые до него гасят их
## собственные системы.
func release_held() -> void:
	move_direction = Vector3.ZERO
	mouse_delta = Vector2.ZERO
	sprint_held = false
