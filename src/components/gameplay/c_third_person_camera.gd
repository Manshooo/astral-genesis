# res://src/components/gameplay/c_third_person_camera.gd
# Камера от третьего лица на риге игрока: числа плеч и опоры (тюнятся в инспекторе e_player.tscn) и то, что системы
# камеры пишут на ходу. Плечи и опора считаются от габарита надетой формы, поэтому числа здесь — доли, а не метры.
# Вики: [[Вид от третьего лица]].
class_name C_ThirdPersonCamera
extends Component

## Длина плеча назад — доля роста формы, но не короче min_arm.
@export var arm_scale := 1.0
@export var min_arm := 1.6
## Сдвиг вбок — доля от (радиус формы + shoulder_pad).
@export var shoulder_scale := 1.0
@export var shoulder_pad := 0.35
## Сторона плеча: 1 — правое, −1 — левое.
@export var side := 1.0
## Опора над глазами формы — доля роста; ниже нуля — под глазами.
@export var pivot_lift := 0.0
## Опора не ниже стольких метров над подошвой: у маленькой формы (душа — 0.52 м) сфера плеча иначе цепляла бы пол
## от малейшего наклона взгляда, и камера прыгала бы к форме и обратно.
@export var min_pivot := 0.9
## Менять плечо, когда своё упёрлось вдвое, а с другой стороны свободнее.
@export var auto_side := false
## Как быстро сдвиг доезжает до стороны после смены плеча, 1/с.
@export var side_speed := 6.0
## Докуда луч из камеры ищет точку под прицелом.
@export var aim_range := 100.0

## Текущий сдвиг вбок со знаком стороны (S_ThirdPersonCamera): при смене плеча он проходит через ноль, а не прыгает.
var offset := 0.0
## Полный сдвиг вбок у нынешней формы (S_ThirdPersonCamera) — его меряет смена плеча у стены.
var reach := 0.0
## Точка под прицелом — куда приходит луч из камеры через центр кадра (S_CameraAim, физкадр). INF — ещё не найдена.
var aim_point := Vector3.INF
