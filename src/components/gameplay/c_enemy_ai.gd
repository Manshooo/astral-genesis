class_name C_EnemyAI
extends Component
## Поведение врага: стоит, пока не заметил воплощённого БФЖ, гонится, видя его,
## идёт на место, где видел последний раз, потеряв из виду, и бьёт в упор по
## кулдауну. Числа авторские, тюнятся в сцене конкретного врага — как
## C_Walk.speed у тел.
##
## Состояние — enum-поле здесь, а не россыпь тег-компонентов C_Idle/C_Chasing:
## так короче путь чтения (одна S_EnemyAI смотрит на одно поле) и нет риска
## навесить сразу два взаимоисключающих тега (см. «GECS и правила движка» про
## FSM в ECS).
##
## Всё, что враг ВИДИТ и ПОМНИТ, живёт здесь же отдельными полями без @export:
## это рантайм-состояние одного экземпляра, в сцене ему делать нечего.

enum State {
	## Стоит: цели нет или не заметил.
	IDLE,
	## Видит цель и идёт на неё (в упор — бьёт).
	CHASING,
	## Потерял цель из виду и идёт на место, где видел её последний раз; дойдя —
	## стоит там [member linger_time] и сдаётся.
	SEARCHING,
}

# --- Бой ---

## Дальность обзора: дальше этого врага цель не замечает и не удерживает.
@export var aggro_range: float = 10.0
## Дистанция, с которой враг бьёт вместо того, чтобы бежать дальше.
@export var attack_range: float = 1.8
@export var attack_damage: float = 15.0
## Пауза между ударами, с.
@export var attack_interval: float = 1.0

# --- Обнаружение ---

## Угол обзора, градусов (полный, не половина). Замечает только цель в этом
## конусе перед собой; уже встревоженный враг (гонится или ищет) конусом не
## ограничен — он смотрит на цель, а не мимо неё.
@export_range(10.0, 360.0, 1.0) var view_angle: float = 110.0
## Ближе этого цель замечается и за спиной (шаги, дыхание): иначе подкравшийся
## сзади вплотную был бы неуязвимой мишенью. Линия видимости нужна и здесь.
@export var awareness_range: float = 2.0
## Высота глаз над ногами, м: лучу обзора нужна точка начала.
@export var eye_height: float = 1.6
## Период проверки обзора, с. Луч бросается не каждый кадр: пятьдесят врагов по
## лучу на физкадр — расход на ровном месте, а замечать цель на пятую долю
## секунды позже незаметно.
@export var sight_interval: float = 0.2
## Что закрывает обзор: стены и подвижная геометрия (двери). Решётки (permeable)
## не закрывают — сквозь них видно, как и в жизни.
@export_flags_3d_physics var sight_mask: int = 1 | (1 << 4)

# --- Память ---

## Сколько враг стоит на месте, где видел цель последний раз, прежде чем
## сдаться, с.
@export var linger_time: float = 4.0
## Потолок поиска, с: дойти до места, где видел, можно и не суметь (цель за
## дверью, путь закрыт) — без этого враг искал бы вечно.
@export var search_timeout: float = 15.0

# --- Путь ---

## Период перестроения пути по навмешу, с. Не каждый кадр: цель сдвигается
## медленно относительно кадра, а запрос пути — не бесплатный.
@export var repath_interval: float = 0.4
## Дистанция до точки пути (по горизонтали), с которой она считается
## пройденной и враг идёт к следующей, м.
@export var waypoint_reach: float = 0.6
## Дистанция до места, где видел цель, с которой оно считается достигнутым, м.
@export var arrive_distance: float = 1.0
## Шаблон навмеша по размеру этого врага — один из LayerNavigation.PROFILES. Свой
## размер, а не общий по самому крупному: агент выше нужного выбрасывает из навмеша
## всё под нависаниями, куда мелкий враг пролез бы. dev/enemy_nav_check сверяет,
## что шаблон покрывает капсулу врага.
@export var nav_profile: NavigationMesh = preload("res://data/enemy_navmesh.tres")

## Текущее состояние — читается HUD/будущими системами, пишет только S_EnemyAI.
@export var state: State = State.IDLE
## Сколько ещё ждать до следующего удара. 0 — можно бить прямо сейчас.
@export var attack_cooldown_left: float = 0.0

# Рантайм-состояние обзора, памяти и пути — пишет только S_EnemyAI.

## Результат последней проверки обзора: видит ли цель. Между проверками остаётся
## прежним.
var sees_target := false
## Сколько осталось до следующей проверки обзора, с. Ноль у свежего врага:
## первый же кадр проверяет сразу.
var sight_left := 0.0
## Сколько лучей обзора брошено за жизнь врага (для проверок и профайлера).
var sight_rays := 0
## Где в последний раз видели цель (мировые координаты, у ног цели).
var last_seen_position := Vector3.ZERO
## Сколько осталось поиска, с (в состоянии SEARCHING).
var search_left := 0.0
## Дошёл ли враг до места последнего виденья.
var arrived := false
## Путь по навмешу к цели; пустой — навмеша нет, идём по прямой.
var path := PackedVector3Array()
var path_index := 0
var repath_left := 0.0
