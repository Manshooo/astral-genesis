class_name C_Flight
extends C_SoulTrait
## Полёт — свободное перемещение без опоры; есть у бестелесного БФЖ, засыпает во плоти. Он же выключает
## гравитацию (S_Gravity: with_none([C_Flight])). Числа абсолютные и лежат рядом с возможностью.

## Скорость полёта, м/с.
@export var speed: float = 4.0

## Разгон до желаемой скорости, м/с²; набирать ход охотнее, чем останавливаться.
@export var acceleration: float = 9.0

## Затухание, когда клавиши отпущены, м/с². Меньше — дольше несёт по инерции.
@export var damping: float = 3.5
