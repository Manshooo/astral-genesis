class_name C_BodyForm
extends Component
## Физический габарит и уровень глаз захваченного тела, надетые на душу-риг.
## Запрос к презентации — ровно тот же приём, что C_BodyVisual → O_BodyVisual:
## логика (S_BodySnatch) вешает компонент, O_BodyForm его применяет,
## O_ExpelFromBody снимает, и наблюдатель возвращает призрачную форму.
##
## Отдельный компонент, а не поля в C_BodyVisual: облик — это то, что видно
## другим, форма — то, чем игрок упирается в мир. «Ползун» вдвое ниже ходока и
## обязан пролезать там, где ходок не пройдёт; это геймплей, а не картинка, и
## тело без визуала (или визуал без коллайдера) должно оставаться выразимым.
##
## Не C_BodyTrait: трейты переносятся на душу общим перебором и читаются
## системами как числа, а форма — это узлы сцены рига (коллайдер и камера),
## которые правит наблюдатель. Держать её в трейтах значило бы, что общий
## перебор молча тащит на душу то, что без наблюдателя ничего не делает.

## Форма коллизии, снятая с тела. null — тело габарита не несёт, риг остаётся в
## своей призрачной форме (так работают тела, которым обвязку ещё не вернули).
@export var shape: Shape3D

## Высота глаз НАД ПОДОШВОЙ тела, метры. Авторится маркером Eyes в сцене тела:
## уровень глаз — часть модели, а не число в коде.
##
## Отрицательное значение = маркера нет. Тогда O_BodyForm берёт долю от высоты
## капсулы, а не молчаливый ноль: ноль посадил бы камеру в пол, и это выглядело
## бы как баг посадки, который мы только что чинили.
@export var eye_height: float = -1.0

## Что вернуть при развоплощении. Заполняет O_BodyForm в момент применения:
## призрачная форма живёт в e_player.tscn, и больше её взять неоткуда — ровно
## как restore_mesh в C_BodyVisual.
@export var restore_shape: Shape3D
@export var restore_camera: Transform3D


## Насколько origin рига окажется ВЫШЕ подошвы, когда эта форма будет надета.
##
## Нужна ДО того, как компонент доедет до рига: захват ставит риг в позицию тела
## ещё в S_BodySnatch, а форму применяет наблюдатель после слива буфера. Спросить
## в этот момент E_Player.foot_offset() значило бы получить призрачный габарит и
## посадить рослое тело по пояс в пол.
##
## Пустая форма → ZERO: у рига остаётся его собственный коллайдер, и офсет
## считает он сам.
func foot_offset() -> Vector3:
	if shape == null:
		return Vector3.ZERO
	var half := E_Player.shape_half_height(shape)
	return Vector3(0.0, half, 0.0) if half >= 0.0 else Vector3.ZERO
