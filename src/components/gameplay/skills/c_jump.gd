class_name C_Jump
extends C_BodyTrait
## Умение прыгать — и насколько сильно у этого тела.
##
## Отсутствие компонента = прыгать нечем (безногое тело). Никакой отдельной
## «галочки can_jump» для этого не нужно, и системе прыжка не нужно ветвление:
## тело без C_Jump просто не попадает в выборку.

## Начальная скорость прыжка вверх, м/с. АБСОЛЮТНАЯ.
@export var velocity: float = 6.0

## Каким действием возможность вызывается. Не зашито в HUD и не завязано на
## конкретную клавишу — резолвится из InputMap по имени, тем же приёмом, что
## C_Interactable.action_name у подсказок взаимодействия: после переназначения
## клавиши HUD покажет новую сам, без правки этого файла.
@export var action_name: StringName = &"jump"
