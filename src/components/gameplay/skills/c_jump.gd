class_name C_Jump
extends C_BodyTrait
## Умение прыгать — и насколько сильно у этого тела.
##
## Отсутствие компонента = прыгать нечем (безногое тело). Никакой отдельной
## «галочки can_jump» для этого не нужно, и системе прыжка не нужно ветвление:
## тело без C_Jump просто не попадает в выборку.

## Начальная скорость прыжка вверх, м/с. АБСОЛЮТНАЯ.
## Это именно СИЛА прыжка; чем прыжок вызывается (какое действие) — вопрос
## раскладки, см. «Возможности тела и раскладка управления».
@export var velocity: float = 6.0
