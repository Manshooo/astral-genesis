class_name C_Attack
extends C_BodyTrait
## Ближний удар тела — и насколько он силён у ЭТОГО тела.
##
## Механика одна на всех (S_Attack: луч из глаз, урон через воронку S_Health),
## а числа у каждого тела свои и лежат в его сцене: гончая кусает часто и
## слабо, военный бьёт редко и больно. Отдельных «классов атаки» нет — разное
## оружие и разные приёмы придут в v0.8.0 новыми компонентами-способностями, а
## не ветвлением внутри этой системы.
##
## Отсутствие компонента = бить нечем. Наследник C_BodyTrait, чтобы удар ехал
## вместе с телом при захвате и снимался при выходе тем же общим проходом, что
## и прыжок (E_Body.is_wearable): ни S_BodySnatch, ни O_ExpelFromBody про атаку
## не знают. Врагу удар не нужен как компонент — он бьёт через C_EnemyAI, у
## которого те же три числа; сцена трупа несёт C_Attack для игрока.

## Урон за удар, абсолютный (см. C_BodyTrait про абсолютные значения).
@export var damage: float = 10.0

## Дальность удара от глаз, м. Луч идёт из камеры, а не из кулака, поэтому
## считается от уровня глаз: у ползуна глаза на полметра от пола, и «два
## метра» для него — это два метра по полу.
@export var reach: float = 2.0

## Пауза между ударами, с.
@export var interval: float = 0.8

## Каким действием вызывается; резолвится из InputMap по имени тем же приёмом,
## что C_Jump.action_name, — HUD покажет новую клавишу после перепривязки.
@export var action_name: StringName = &"attack"

## Сколько ещё ждать до следующего удара. Рабочее состояние, не авторское
## (без @export): в сцене задают темп тела, а не остаток паузы в момент
## сохранения. 0 — можно бить прямо сейчас. Копия при захвате начинает с нуля,
## и это нормально: пересадка сама стоит игроку кадра и удара.
var cooldown_left := 0.0
