class_name C_Sheltered
extends Component
## Душа стоит в убежище от распада (DecayShelter): запас восполняется, S_Lifespan её не тикает
## (хватает with_none), берёт S_DecayShelter. Ссылки на зону нет — зона выгружается со слоем.
## В сейв не пишется: без зоны вокруг маркер дал бы бессмертие.

## Секунд запаса в секунду; копируется из зоны при входе.
@export var refill_rate: float = 10.0
## В скольких зонах душа стоит: счётчик, границы соседних убежищ перекрываются.
@export var zones: int = 1
