class_name C_Lifespan
extends Component
## Распад БФЖ. Две шкалы, которые по сути один ресурс, перетекающий туда-обратно:
## запас САМОЙ ДУШИ и запас ТЕЛА, в котором она сейчас сидит.
##
## Время везде идёт 1 с/с — тело не замедляет ход времени. Тикает та шкала,
## которая соответствует состоянию: во плоти расходуется запас тела, собственный
## запас души в это время не трогается и ждёт. Отсюда и берётся смысл вселения:
## это не «продление», а другой карман, из которого можно платить.
##
## Куда девается остаток тела при выходе, решает O_ExpelFromBody: вышел сам —
## остаток ПРИБАВЛЯЕТСЯ к запасу души (можно уйти за максимум), тело погибло —
## не даёт ничего, и от запаса души остаётся малая доля.

## Собственный запас души: сколько секунд БФЖ протянет БЕЗ тела.
@export var max_duration: float = 60.0
## Текущий запас души. МОЖЕТ превышать max_duration — излишек, принесённый из
## тела, утекает быстрее обычного (S_Lifespan).
@export var current: float = 60.0

@export_group("Тело")
## Остаток запаса ТЕЛА. Тикает вместо собственного, пока на душе есть C_Embodied.
@export var body_current: float = 0.0
## С чего этот запас начинался — из C_BodySnatchable.lifespan захваченного тела.
## Нужен шкале в HUD: без него у полоски тела нет масштаба.
@export var body_max: float = 0.0


## Сколько всего секунд у игрока в обоих карманах. То, что он на самом деле
## «имеет» — по нему и стоит судить о близости конца.
func total() -> float:
	return current + body_current


## Есть ли излишек сверх собственного максимума (принесённый из тела).
func overflow() -> float:
	return maxf(current - max_duration, 0.0)
