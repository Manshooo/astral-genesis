class_name C_Lifespan
extends Component
## Распад БФЖ — СОБСТВЕННЫЙ запас души: сколько секунд она протянет без тела.
##
## Второй карман — запас тела, в котором душа сейчас сидит, — живёт отдельным
## компонентом C_BodyDecay, который приходит вместе с телом и уходит вместе с
## ним. По сути это один ресурс, перетекающий туда-обратно.
##
## Время везде идёт 1 с/с — тело не замедляет ход времени. Тикает тот карман,
## который соответствует состоянию: во плоти расходуется запас тела, собственный
## запас души в это время не трогается и ждёт. Отсюда и берётся смысл вселения:
## это не «продление», а другой карман, из которого можно платить.
##
## Куда девается остаток тела при выходе, решает O_ExpelFromBody: вышел сам —
## остаток ПРИБАВЛЯЕТСЯ к запасу души (можно уйти за максимум), тело погибло —
## не даёт ничего, и от запаса души остаётся малая доля.

## Собственный запас души БЕЗ тела, секунды — БАЗОВОЕ авторское число. Скиллы
## его не переписывают: их прибавки живут в C_StatModifiers и учитываются в
## effective_max(). Иначе снять эффект было бы нечем — база уже потеряна.
@export var max_duration: float = 60.0
## Текущий запас души. МОЖЕТ превышать максимум — излишек, принесённый из тела,
## утекает быстрее обычного (S_Lifespan).
@export var current: float = 60.0


## Максимум с учётом модификаторов души. Душу приходится передавать аргументом:
## компонент — чистые данные и своего владельца не ищет.
func effective_max(soul: Entity) -> float:
	return C_StatModifiers.of(soul, C_StatModifiers.SOUL_LIFESPAN, max_duration)


## Есть ли излишек сверх собственного максимума (принесённый из тела).
func overflow(soul: Entity) -> float:
	return maxf(current - effective_max(soul), 0.0)
