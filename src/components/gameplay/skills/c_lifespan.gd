class_name C_Lifespan
extends Component

## Собственный запас души: сколько секунд БФЖ протянет БЕЗ тела.
@export var max_duration: float = 60.0
@export var current: float = 60.0

## Сколько секунд к запасу добавляет вселение в тело.
##
## Время НИКОГДА не идёт медленнее реального: раньше во плоти распад тикал с
## множителем, и подпись «45 с» врала — эти 45 секунд шли вдвое дольше. Теперь
## тикает всегда 1 с/с, а тело просто увеличивает сам запас (60 → 120), и
## подписи можно верить.
##
## Пока это одно число на все тела. В v0.5.0 станет свойством конкретного тела
## плюс правила переноса остатка — см. «Характеристики захватываемых тел».
@export var embodied_bonus: float = 60.0


## Потолок запаса в текущем состоянии. Во плоти — свой запас души плюс то, что
## даёт тело. Правило одно на всех (тик, дозаправка при вселении, шкала в HUD),
## поэтому живёт здесь, а не переписывается в трёх местах.
func effective_max(embodied: bool) -> float:
	return max_duration + (embodied_bonus if embodied else 0.0)
