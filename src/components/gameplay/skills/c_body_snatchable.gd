class_name C_BodySnatchable
extends Component
## Помечает сущность как тело, которое БФЖ может захватить (S_BodySnatch), и
## несёт ХАРАКТЕРИСТИКИ этого тела — всё, чем одно тело отличается от другого.
## Ради них задача и затевалась: вселение должно быть выбором, а выбор бывает
## только между разными вариантами.
##
## Числа авторятся в сцене тела (component_resources), а не в коде — пресеты тел
## тюнит дизайнер. Что из них куда переезжает при вселении, см. S_BodySnatch:
## прочность → C_Health, запас → C_Lifespan, множители → C_BodyStats.

## Прочность тела: с каким C_Health душа в нём окажется.
@export var max_health: float = 100.0

## Сколько секунд можно прожить В ЭТОМ теле — его собственный запас распада.
## ОТДЕЛЬНОЕ число, а не формула от прочности: «хрупкое, но долгоиграющее» тело
## должно быть выразимо, иначе выбор сводится к «бери что покрепче».
@export var lifespan: float = 60.0

## Множители к базовым значениям игрока, а НЕ абсолютные величины: скорость и
## сила прыжка живут в пользовательских настройках (RS_Settings), и подменять их
## телом значило бы затирать выбор игрока. Тело делает его быстрее или медленнее
## относительно того, что он себе настроил.
@export var move_speed_scale: float = 1.0

## Сила прыжка относительно базовой. Это именно ВЫСОТА прыжка; вопрос «умеет ли
## это тело прыгать вообще» — другая ось, там возможность = компонент
## (см. «Возможности тела и раскладка управления»).
@export var jump_scale: float = 1.0
