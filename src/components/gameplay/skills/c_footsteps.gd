class_name C_Footsteps
extends C_BodyTrait
## Звук шагов этого тела: какое событие byProd играть и как его отмерять.
##
## Тело без этого компонента ходит молча — и это осмысленный случай, как и тело
## без C_Walk: ползун волочится, а не топает, а бестелесный БФЖ шагов не издаёт
## вовсе (он летит, см. S_Flight). Раз это характеристика тела, она и лежит в
## сцене тела рядом с C_Walk и переносится при захвате вместе с ним.
##
## Отсюда же и «звук игрока»: собственных шагов у души нет, звучит то тело,
## которое на ней надето, — компонент приезжает на душу при захвате и уезжает
## при развоплощении, и никакой отдельной ветки «а это игрок» здесь не нужно.


## Как устроено событие в проекте byProd. Это свойство СОБЫТИЯ, а не тела:
## разовый оно звук или замкнутая петля, решает звуковик в редакторе byProd, и
## механике остаётся только не спорить с тем, что ей дали.
enum Playback {
	## Событие доигрывает само: система запускает по одному на каждый шаг.
	PER_STEP,
	## Событие зациклено: система держит один инстанс, пока тело идёт, и правит
	## ему темп. Запускать такое «на каждый шаг» нельзя — оно не кончается, и
	## инстансы копились бы, пока не кончатся голоса.
	LOOP,
}

## Событие в проекте byProd. Пути событий выглядят как "event:/имя".
@export var event_path: String = "event:/footstep"

@export var playback: Playback = Playback.PER_STEP

@export_group("Разовый звук")

## Сколько метров тело проходит между двумя шагами. Больше — реже топает:
## у длинноногого шаг длиннее, у ползуна короче.
##
## Шаг отмеряется ПУТЁМ, а не временем: иначе медленно крадущееся тело топало бы
## с той же частотой, что и бегущее, и звук разошёлся бы с картинкой.
@export var stride: float = 1.9

@export_group("Петля")

## Float-параметр события, в который уходит темп ходьбы. Пустое имя — петля
## играет как записана, с постоянной скоростью.
@export var tempo_parameter: String = ""

## Скорость (м/с), на которой петля играет как записана, темпом 1.0. Всё
## остальное — доля от неё: вдвое медленнее идущее тело шаркает вдвое реже.
@export var tempo_reference_speed: float = 4.5

## Потолок темпа. Параметры byProd объявлены с диапазоном, и значение за его
## границей рантайм всё равно подрежет, — но подрезать здесь честнее, чем
## отдавать наружу заведомо неверное число.
@export var tempo_maximum: float = 2.0

## Накопленный с прошлого шага путь, м. Состояние системы S_Footsteps живёт
## здесь, а не в самой системе: системы GECS итерируют архетипы и собственного
## состояния на сущность не держат.
var travelled: float = 0.0

## Живой ByProdEventInstance в режиме LOOP, пока тело идёт.
##
## Тип Object, а не имя класса расширения: расширение может отсутствовать
## штатно (рантайма byProd нет в репозитории), а компонент со ссылкой на
## незагруженный класс не проходит парсер и валит сцену тела целиком.
##
## Держать инстанс здесь — не «кэш ради скорости»: пока на него есть ссылка,
## голос занят и его есть кому остановить. Компонент уезжает с телом при
## захвате — вместе с ним уезжает и звучащая петля, и это ровно то поведение,
## которого ждёшь: шаги принадлежат телу.
var loop_instance: Object = null

## Ходьба сейчас озвучена. Отдельный флаг, а не проверка `loop_instance != null`:
## инстанса может не быть штатно (нет рантайма, нет такого события), и без флага
## система пыталась бы завести петлю каждый кадр — и каждый кадр заново
## рассказывала бы об этом наружу.
var loop_active: bool = false
