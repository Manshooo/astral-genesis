class_name C_Footsteps
extends C_BodyTrait
## Звук шагов тела: какое событие byProd играть и как отмерять. Нет компонента = ходит молча.
## Характеристика тела — едет на душу при захвате, отдельной ветки «игрок» нет. Вики: [[Звук]] §3.


## Устройство события в byProd — свойство события, не тела: решает звуковик.
enum Playback {
	## Доигрывает само: по одному на шаг.
	PER_STEP,
	## Зациклено: один инстанс, пока тело идёт; «на каждый шаг» нельзя — инстансы копились бы.
	LOOP,
}

## Событие в проекте byProd. Пути событий выглядят как "event:/имя".
@export var event_path: String = "event:/footstep"

@export var playback: Playback = Playback.PER_STEP

@export_group("Разовый звук")

## Метров между двумя шагами; отмеряется ПУТЁМ, не временем.
@export var stride: float = 1.9

@export_group("Петля")

## Float-параметр события, куда уходит темп; пустое — петля играет как записана.
@export var tempo_parameter: String = ""

## Скорость (м/с), на которой петля играет как записана (темп 1.0).
@export var tempo_reference_speed: float = 4.5

## Потолок темпа (рантайм всё равно подрежет значение за границей параметра).
@export var tempo_maximum: float = 2.0

## Накопленный с прошлого шага путь, м; состояние тут, а не в системе GECS.
var travelled: float = 0.0

## Живой ByProdEventInstance в режиме LOOP. Тип Object: расширение может отсутствовать, и компонент с
## именем его класса не пройдёт парсер. Едет с телом при захвате.
var loop_instance: Object = null

## Ходьба озвучена; отдельный флаг: инстанса может не быть штатно, и без флага петлю заводили бы каждый кадр.
var loop_active: bool = false
