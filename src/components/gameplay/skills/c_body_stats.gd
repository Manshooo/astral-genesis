class_name C_BodyStats
extends Component
## Характеристики тела, НАДЕТЫЕ на душу: «чем я сейчас являюсь». Заполняет
## S_BodySnatch из C_BodySnatchable захваченного тела, снимает O_ExpelFromBody.
##
## Отдельный компонент, а не тот же C_BodySnatchable: тот означает «меня можно
## захватить», и на душе он сделал бы её собственной целью захвата.
##
## Здесь лежит только то, чему больше негде жить. Прочность тела уже выражена
## C_Health (текущее HP — состояние, а не характеристика), запас распада —
## C_Lifespan.body_current. Дублировать их сюда значит завести два источника
## правды и получить рассинхрон на первом же уроне.
@export var move_speed_scale: float = 1.0
@export var jump_scale: float = 1.0
