class_name C_Sprint
extends C_BodyTrait
## Умение ускоряться (бежать) — и насколько сильно у этого тела.
##
## Отсутствие компонента = бежать нечем. У ползуна (e_body_crawler.tscn) его нет
## намеренно: половина тела волочится по полу, и «побежать» ей нечем — ровно
## как ей нечем прыгать (у неё нет и C_Jump). Никакой галочки «can_sprint» для
## этого не нужно, и системе бега не нужно ветвление: тело без C_Sprint просто
## не попадает в её выборку.
##
## ЕДИНСТВЕННОЕ ЧИСЛО ЗДЕСЬ — МНОЖИТЕЛЬ, и это осознанное исключение из правила
## «характеристики тела абсолютны» (см. C_BodyTrait). Абсолютная скорость бега
## означала бы, что перк «+2 м/с к ходьбе» на бег не влияет вовсе: бег брал бы
## своё число мимо C_Walk. Множитель же говорит ровно то, что и должен, — «бег
## этого тела во столько раз быстрее ЕГО ЖЕ шага», — и чужой базы не требует:
## база лежит в C_Walk той же самой сцены, в полуметре по файлу.
@export var speed_multiplier: float = 1.7

## Каким действием возможность вызывается. Резолвится из InputMap по имени — тем
## же приёмом, что C_Jump.action_name: после переназначения клавиши HUD покажет
## новую сам, без правки этого файла.
@export var action_name: StringName = &"sprint"

## Бежим ли ПРЯМО СЕЙЧАС. Рабочее состояние, не авторское, поэтому без @export:
## в сцене тела задают, насколько оно быстрое, а не бежит ли оно в момент
## сохранения.
##
## Нужно именно поле, а не «спросить у Input каждый кадр»: модификатор ставится
## и снимается ПО ФРОНТУ (см. S_Sprint), а фронт без памяти о прошлом кадре не
## увидеть.
var active := false
