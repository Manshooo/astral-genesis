class_name C_BodyTrait
extends Component
## Базовый класс характеристик, которые тело ОТДАЁТ душе: S_BodySnatch переносит на душу ВСЕ его
## наследники, O_ExpelFromBody снимает. Значения абсолютные («сколько у ЭТОГО тела»); эффективные
## считаются из базы и C_StatModifiers при чтении. Наличие компонента = наличие возможности (без ветвлений
## по типу тела). Возможности самой души — C_SoulTrait. Вики: [[Захват тела]].


## Момент надевания трейта на душу (зовёт S_BodySnatch): для трейтов, где авторское и рабочее число
## различаются (C_BodyDecay). [param _soul] явно: трейт ещё не надет, parent пуст.
func on_worn(_soul: Entity) -> void:
	pass
