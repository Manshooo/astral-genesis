class_name C_Embodied
extends Component
# БФЖ сейчас во плоти. Отсутствие компонента = развоплощён (призрак), тогда
# тикает C_Lifespan (S_Lifespan) и идёт распад.
#
# Не пустой маркер: несёт путь к СЦЕНЕ занятого тела — тот самый «id пресета»,
# из которого после загрузки восстанавливается облик. Сам меш в сейв не пишется:
# источник правды о внешности один — сцена тела (см. E_Body.visual_of).

## Сцена тела, в котором сидит душа (например res://src/entities/body/e_body_hound.tscn).
## Заполняет S_BodySnatch при вселении; пустая строка означает, что компонент
## навесили в обход захвата — облик тогда восстановить неоткуда.
@export var body_scene_path: String = ""
