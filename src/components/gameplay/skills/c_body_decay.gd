class_name C_BodyDecay
extends C_BodyTrait
## Карман распада ТЕЛА: сколько секунд душа проживёт в нём, платя его временем, а
## не своим (собственный запас души — C_Lifespan).
##
## Компонент, а не пара полей в C_Lifespan: карман существует ровно столько,
## сколько существует тело. Полями он лежал бы мёртвыми нулями всё время, пока
## игрок призрак, и «есть ли у меня тело» приходилось бы спрашивать у другого
## компонента. Здесь наличие компонента и есть ответ.
##
## Запас — ОТДЕЛЬНОЕ число, а не формула от прочности тела: «хрупкое, но
## долгоиграющее» тело должно быть выразимо, иначе выбор сводится к «бери что
## покрепче».

## Сколько секунд тело даёт целиком — АВТОРСКОЕ число пресета. Скиллы его не
## трогают: их прибавки лежат отдельным слоем (C_StatModifiers) и учитываются
## при чтении, см. effective_maximum.
@export var maximum: float = 60.0

## Сколько осталось. Состояние, а не характеристика, — поэтому НЕ @export: в
## сцене тела его авторить нечего, заполняется при надевании (on_worn) и
## восстанавливается из сейва числом.
var remaining: float = 0.0


## Тело надето — карман открывается полным.
##
## Пересадка из тела в тело остаток ПРОШЛОГО тела сжигает (старый компонент
## снимается целиком): иначе выгодной стратегией стало бы прыгать по телам, копя
## чужое время, и добровольный выход — единственный способ забрать остаток —
## обесценился бы.
func on_worn(soul: Entity) -> void:
	remaining = effective_maximum(soul)


## Сколько секунд тело даёт ЭТОЙ душе: авторское число пресета плюс её
## модификаторы. «+10% к длительности распада» — обычный скилл, а не правка тел.
func effective_maximum(soul: Entity) -> float:
	return C_StatModifiers.of(soul, C_StatModifiers.BODY_DECAY, maximum)
