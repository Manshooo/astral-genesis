class_name C_Interactable
extends Component

@export var action_name: StringName = &"interact"
## Подпись подсказки — ключ перевода (`assets/locale/ui.csv`): переводит её
## подсказка HUD, потому что клавиша вклеивается рядом уже после перевода.
@export var prompt_text: String
@export var enabled: bool = true
## Показывать ли в подсказке клавишу действия ("[F] Пройти"). false — для
## объектов, которые подсвечиваются и объясняют себя, но нажимать на них
## бессмысленно (напр. запечатанная дверь: «Прохода нет»).
@export var show_key_hint: bool = true

## Нужно ли ТЕЛО, чтобы этим воспользоваться. БФЖ — бестелесное сознание: рычаг
## не повернёшь и кнопку не нажмёшь, пока не вселился.[br]
## Двери помечены (решение 20.10): развоплощённый заперт в комнате, пока не
## найдёт тело, — это и держит «без тела долго не прожить». Порталы — нет: их
## не открывают руками. Хаб стартует с телом в комнате, поэтому забег не
## встаёт намертво на первой же двери.
@export var requires_body: bool = false
