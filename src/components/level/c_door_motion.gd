class_name C_DoorMotion
extends Component
## Ход двери: куда и за сколько уезжает полотно, сколько дверь стоит открытой и
## в какой она сейчас фазе. Одиночное полотно уезжает вверх, в притолоку, створки
## двустворчатой разъезжаются вбок, в толщу стены. Двигает полотно S_DoorMotion,
## открывает дверь RunManager.use_door там, где за ней коридор, — дверь не
## переход между узлами, а препятствие, которое убирают с дороги.
##
## Лежит в сцене двери с самого начала, а не вешается при открытии, по двум
## причинам. Настройки хода — свойство типа двери: шлюз может держаться открытым
## дольше гермодвери, и взяться таким числам, кроме сцены, неоткуда. И у двери
## одно звуковое событие на всю жизнь, а состояния — сигналы в него (см. sound):
## снимай компонент на закрытии — инстанс пропадал бы вместе с ним посреди звука
## закрытия.
##
## Раньше дверь оставалась открытой навсегда («закрывать за игроком нечего»);
## теперь закрывается сама — карточка «Двери закрываются сами». После загрузки
## комплекс собирается из сида, и двери снова закрыты: фаза в сейв не идёт.

## Фаза хода. Полем, а не тег-компонентами: переходы — запись поля, а не
## структурная правка через cmd на каждом шаге ([[GECS и правила движка]], FSM).
enum Phase {
	CLOSED,
	OPENING,
	## Открыта полностью и ждёт hold секунд.
	OPEN,
	CLOSING,
}

## На сколько поднять одиночное полотно. Полотно 4.2 м — с запасом, чтобы нижняя
## кромка ушла выше проёма целиком, а не торчала гильотиной.
@export var lift: float = 4.4
## На сколько отъехать каждой створке двустворчатой двери от центра проёма. Вбок,
## а не вверх: в клетке 8 м поднятое полотно (проём 4.25 + полотно 4.24) уходило
## бы в клетку уровня выше, а створки прячутся в стену на своём уровне. Створка
## ~1.37 м — с запасом, чтобы кромка ушла за откос целиком.
@export var slide: float = 1.4
## За сколько секунд полотно проходит путь — в одну сторону, туда и обратно
## одинаково.
@export var duration: float = 0.8
## Сколько секунд дверь стоит открытой, считая от момента, когда открылась
## ПОЛНОСТЬЮ. От начала хода дверь, открывающаяся 0.8 с, стояла бы открытой
## всего 1.2 с.
@export var hold: float = 2.0

@export_group("Выталкивание")

## Кого закрывающаяся дверь выталкивает из проёма. Закрытие не ждёт пустого
## проёма, а створки сходятся вбок — сами они тело только зажмут, а выйти ему
## нужно поперёк проёма.
@export_flags_3d_physics var push_mask: int = 0b110
## С какой скоростью, м/с. Быстрее, чем створки сходятся: тело обязано выйти из
## проёма раньше, чем до него доедет кромка.
@export var push_speed: float = 8.0

@export_group("Звук")

## Событие byProd двери — одно на все её состояния.
@export var event_path: String = "event:/vfx/door"
## Сигнал в событие на старте открытия. На старте, а не по окончании хода: звук
## сопровождает движение полотна.
@export var opened_signal: String = "door_opened"
## Сигнал в событие на старте закрытия.
@export var closed_signal: String = "door_closed"

## Текущая фаза. Не экспорт: это состояние, а не настройка.
var phase: Phase = Phase.CLOSED
## 0..1 — сколько пути полотно прошло от точки покоя.
var progress: float = 0.0
## Сколько секунд дверь уже стоит открытой полностью.
var held: float = 0.0
## Живой ByProdEventInstance двери, заведённый на первом открытии.
##
## Тип Object, а не имя класса расширения: рантайма byProd может не быть штатно,
## а ссылка на незагруженный класс валила бы сцену двери на парсере (так же, как
## C_Footsteps.loop_instance). Держится здесь всю жизнь двери: пока на него есть
## ссылка, сигналу есть куда прийти, а выгрузка слоя роняет её вместе с дверью.
var sound: Object = null
