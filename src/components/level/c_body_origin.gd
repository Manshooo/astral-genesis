class_name C_BodyOrigin
extends Component
# Стабильный идентификатор авторского тела внутри комплекса. Штампует RunManager
# при спавне комнаты — ровно как раздаёт дверям C_DoorPortal: в самой сцене тела
# id взяться неоткуда, один и тот же e_body.tscn стоит в разных комнатах, а
# складывается id из узла графа и пути узла внутри комнаты.
#
# Нужен ровно для одного: сейв помечает поглощённые тела
# (RS_WorldSave.consumed_body_ids), чтобы восстановленная из сида комната не
# подсунула дубликат того, в ком игрок сейчас сидит.

## "<id узла графа>/<путь узла в комнате>", например "hub_0/Body".
@export var body_id: StringName = &""
