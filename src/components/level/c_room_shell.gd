class_name C_RoomShell
extends Component
## Комната по маске сокетов: сцена — коробка (пол, потолок, пропы), стену на каждую грань ставит спавн, двери
## решает раскладка. Лежит на корне сцены-коробки; footprint и стиль — свойства геометрии, поэтому здесь, не в
## пресете (сверяет dev/room_shell_check). Системы не читают. Вики: [[Метрики и кит]] §сокеты.

## Footprint в клетках: ширина по X, уровней по Y, длина по Z.
@export var size: Vector3i = Vector3i.ONE
## Детали стен стиля коробки.
@export var walls: RS_RoomWallKit
## Грани, где у коробки может быть дверь, в осях сцены: клетка footprint от нижней северо-западной и сторона
## (0 — север … 3 — запад), как GridTopology.face. Пусто — все грани нижнего уровня. Объявляет комната, где вход решает
## содержимое (лестница); грань выше нижнего уровня оставляет раскладка того этажа (RS_LayerPlan.pending_doors).
@export var door_sockets: Array[Vector4i] = []
## Грани, которыми комната выходит наружу, в осях door_sockets: сборка ставит проём и дверь наружу
## (RS_RoomWallKit.exit_door), а не дверь в коридор. door_sockets тогда обязателен (RS_RoomPresetLibrary).
@export var exit_sockets: Array[Vector4i] = []
## Стены нарисованы в самой коробке (walled_*): сборка закрывает невыбранные сокеты заглушкой
## (RS_RoomWallKit.plug), сокеты объявлять обязательно. Флаг, а не по door_sockets: лестница объявляет сокеты, но стены ставит сборка.
@export var walls_in_shell: bool = false
