class_name C_RoomShell
extends Component
## Комната собирается по маске сокетов: сцена — только коробка (пол, потолок,
## пропы), стену на каждую грань клетки по периметру ставит спавн, а какие грани
## станут дверями, решает раскладка (карточка «Сетка уровня»). Второй вид коробки —
## со стенами в меше (walls_in_shell): там спавн только закрывает невыбранные
## сокеты заглушкой. Компонент лежит на
## корне сцены-коробки и отличает такую комнату от комнаты с дверями, запечёнными
## в сцену (C_DoorSlot).
##
## Размер и стиль — здесь, а не в пресете: footprint — свойство геометрии коробки
## (shell_2x2x1 и есть 2×2×1), стиль стен — стиль коробки, и в пресете они молча
## разъехались бы со сценой. Совпадение коробки с footprint сверяет
## dev/room_shell_check.
##
## Системы его не читают: это данные сцены для генератора и спавна.

## Footprint в клетках: ширина по X, уровней по Y, длина по Z.
@export var size: Vector3i = Vector3i.ONE
## Детали стен стиля коробки.
@export var walls: RS_RoomWallKit
## Грани, на которых у коробки может быть дверь, — в осях сцены: клетка
## footprint от нижней северо-западной (x — к востоку, y — уровень, z — к югу) и
## сторона (0 — север, 1 — восток, 2 — юг, 3 — запад), как GridTopology.face.
## Пусто — все грани нижнего уровня по периметру: обычной комнате всё равно, с
## какой стороны в неё войдут, и выбирает раскладка.
##
## Объявляет комната, у которой вход решает содержимое. Лестнице дверь нужна у
## подножия и у верхней площадки, а на остальных гранях проём упёрся бы в марш.
## Грань выше нижнего уровня — дверь на этаж выше: раскладка этажа комнаты
## оставляет её раскладке того этажа (RS_CorridorPlanner, RS_LayerPlan.pending_doors).
## Здесь, а не в пресете, по той же причине, что и size: где площадка — свойство
## геометрии коробки.
@export var door_sockets: Array[Vector4i] = []
## Стены нарисованы в самой коробке (walled_*), а не ставятся по граням: комнату
## рисуют целиком, без шва через каждые 8 м и без одинаковых стен во всех
## комнатах стиля. Сборка тогда трогает только объявленные сокеты — на дверь
## ставит полотно, на остальные заглушку (RS_RoomWallKit.plug); прочие грани уже
## в меше. Сокеты такой коробке объявлять обязательно: проёмы в её меше и есть
## сокеты, и «все грани периметра» значили бы дверь в глухую стену.
##
## Флагом, а не по наличию door_sockets: лестница объявляет сокеты, но стены ей
## ставит сборка — глухие грани её марша держит blank_wall.
@export var walls_in_shell: bool = false
