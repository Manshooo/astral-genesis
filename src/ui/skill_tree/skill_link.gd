# res://src/ui/skill_tree/skill_link.gd
## Связь-требование между двумя карточками навыков — одно ребро графа.
##
## Line2D, а не draw_polyline в общем слое: толщина, сглаживание, скругление
## концов и текстура линии тем самым правятся в редакторе, а не подбираются
## числами в коде. Заодно исчезает ловушка ручного рисования — у контрола,
## который рисует за пределами своего прямоугольника, приходилось заводить рект
## руками, иначе движок отсекал весь слой целиком; у узла рект свой.
##
## Форма кривой остаётся кодом: она выводится из положения карточек, то есть из
## данных, а не из вкуса.
class_name UI_SkillLink
extends Line2D

## Густота связи. Линия — подсказка о структуре, а не сама структура: в полную
## силу цвета ветки она спорила бы с карточками, между которыми проведена.
@export var line_alpha := 0.5
## Во сколько раз бледнее связь, ведущая в карточку-предпросмотр: она ведёт
## туда, куда игрок пока не может пойти, и наравне с рабочими рёбрами читалась
## бы как путь.
@export var preview_alpha_scale := 0.45
## Сегментов на кривую. Больше — глаже, но на глаз разница выше десятка уже не
## видна, а точек в линии становится вдвое больше.
@export var segments := 14
## Минимальный горизонтальный «ус» кривой. Не даёт связи между соседними
## колонками выродиться в прямую, которая перечеркнёт чужие карточки.
@export var handle_min := 40.0


## [param from] и [param to] — точки на краях карточек, их считает граф: только
## он знает размер клетки. Здесь остаётся форма кривой и цвет.
func connect_cards(from: Vector2, to: Vector2, color: Color, dimmed: bool) -> void:
	var handle := maxf((to.x - from.x) * 0.5, handle_min)
	var c1 := from + Vector2(handle, 0.0)
	var c2 := to - Vector2(handle, 0.0)

	var curve := PackedVector2Array()
	for i in segments + 1:
		curve.append(from.bezier_interpolate(c1, c2, to, float(i) / float(segments)))
	points = curve

	default_color = Color(color, line_alpha * (preview_alpha_scale if dimmed else 1.0))
