# res://src/ui/skill_tree/skill_lane.gd
## Дорожка ветки — подложка под карточками одной категории навыков и её подпись
## в левом жёлобе.
##
## Вёрстка живёт в skill_lane.tscn: подложка, ширина жёлоба, выравнивание и
## шрифт подписи правятся глазами. Раньше дорожка была двумя вызовами
## draw_rect/draw_string внутри слоя связей — «как она выглядит» жило в коде, а
## подпись не подчинялась даже теме.
##
## Прямоугольник дорожке выдаёт граф (UI_SkillGraph._lane_band): он считается по
## ПОКАЗАННЫМ карточкам ветки, и знать про них дорожке незачем. Её дело — цвет
## ветки и то, как это нарисовано.
class_name UI_SkillLane
extends Control

## Насколько густо ветка красит свою полосу. Подложка — фон под карточками, и
## различима она должна быть на грани: она отвечает на вопрос «чьё это место»,
## а не соревнуется с карточками за внимание.
@export var fill_alpha := 0.06
@export var label_alpha := 0.8

@onready var _fill: Panel = %Fill
@onready var _label: Label = %Name


## Зовётся графом ПОСЛЕ добавления дорожки в дерево сцены: до этого
## @onready-ссылки не подняты.
func setup(display_name: String, color: Color) -> void:
	name = "Lane_" + display_name
	_label.text = display_name
	# Цвет ветки идёт в modulate подложки, а не в её стилбокс: стилбокс в сцене
	# ОДИН на все дорожки, и покраска через bg_color перекрасила бы их разом.
	# Подписи — наоборот, цвет шрифта: modulate умножился бы на цвет из темы, и
	# ветка получилась бы не своего цвета, а темы, пропущенной через свой.
	_fill.modulate = Color(color, fill_alpha)
	_label.add_theme_color_override("font_color", Color(color, label_alpha))


## Ширина левого жёлоба — того места, где стоит подпись ветки. Граф отодвигает
## на неё все карточки, поэтому спрашивает её у сцены, а не хранит своим числом.
func gutter_width() -> float:
	return $Gutter.size.x
