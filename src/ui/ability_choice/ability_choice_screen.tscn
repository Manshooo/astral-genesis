[ext_resource type="Script" path="res://src/ui/menu/echo_button.gd" id="3_echo"]

[sub_resource type="Gradient" id="Gradient_shadow"]
colors = PackedColorArray(0.024, 0.02, 0.035, 0.7, 0.024, 0.02, 0.035, 0)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_shadow"]
gradient = SubResource("Gradient_shadow")
width = 128
height = 128
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[node name="AbilityChoice" type="Control" node_paths=PackedStringArray("first_focus", "content")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_screen")
