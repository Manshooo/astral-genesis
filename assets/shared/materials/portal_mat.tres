shader_parameter/uv1_offset = Vector3(0, 0, 0)
shader_parameter/wave_amplitude = 0.0990000047025
shader_parameter/wave_frequency = 1.30000001937156
shader_parameter/spiral_speed = 0.15000007674118
shader_parameter/secondary_amplitude = 0.12800000608
shader_parameter/secondary_frequency = 3.20000004768384
shader_parameter/stripe_count = 8.0
shader_parameter/stripe_sharpness = 3.0
shader_parameter/stripe_scroll_speed = 1.5
shader_parameter/stripe_color = Color(0.3108071, 0.39872357, 0.4625615, 1)
