; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Astral Genesis"
config/description="Пост-апокалиптический roguelike-dungeon-crawler."
config/version="0.3.0"
config/tags=PackedStringArray("dungeon_crawler", "first_person", "roguelike")
run/main_scene="uid://cnoq0anpv63fs"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="uid://074x3puupfnm"

[autoload]

GameConfig="*uid://c2loo5mfx0ufk"
SettingsManager="*uid://b3rnljshci5d7"
SkillManager="*uid://bwpci4sr0qv4f"
UIManager="*uid://d13q83ngp0nm4"
WorldSave="*res://src/autoloads/world_save.gd"
RunManager="*uid://c6536kxev8382"
ECS="*uid://dfqwl5njvdnmq"

[display]

window/size/viewport_width=1497
window/size/viewport_height=720
window/stretch/scale_mode="integer"

[editor]

version_control/plugin_name="GitPlugin"

[editor_plugins]

enabled=PackedStringArray("res://addons/entity_template_tool/plugin.cfg", "res://addons/gecs/plugin.cfg", "res://addons/level_gen_tool/plugin.cfg")

[file_customization]

folder_colors={
"res://src/autoloads/": "gray",
"res://src/components/": "yellow",
"res://src/entities/": "green",
"res://src/observers/": "orange",
"res://src/resources/": "gray",
"res://src/systems/": "purple",
"res://src/ui/": "red",
"res://src/world/": "blue"
}

[gecs]

settings/debug_mode=true

[gui]

theme/custom="uid://e0o8cuoinatk"

